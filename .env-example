# Example environment file (constraint #6: real secrets live in git-ignored files only).
# Copy to `.env` / set in the shell; NOTHING here is required for keyless CI.

# M6-4 Gmail one-time consent (scripts/gmail_auth.py, operator-run, email-live group):
# the Desktop OAuth client downloaded from Google Cloud for the DEDICATED TEAM account,
# and where the authorized-user token lands. Both defaults are git-ignored.
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json
