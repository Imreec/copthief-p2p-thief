# Copy to .env and fill with real values. NEVER commit .env.
# CI is keyless — none of these are needed for tests.

# Gmail API (send-only scope; used from M6). Files themselves are git-ignored.
GMAIL_CLIENT_SECRET_FILE=client_secret.json
GMAIL_TOKEN_FILE=token.json

# Named tunnel (used from M2)
TUNNEL_TOKEN=dummy-tunnel-token

# Optional live LLM providers (verbal layer only; template mode needs none)
ANTHROPIC_API_KEY=dummy-key
OLLAMA_HOST=http://localhost:11434
