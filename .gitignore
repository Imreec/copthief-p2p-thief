# Secrets — NEVER commit
.env
.env.local
*.key
*.pem
credentials.json
secrets/

# OAuth / token / tunnel state — NEVER commit
client_secret*.json
token*.json
*.token
*.tunnel
ngrok*.yml
cloudflared*.yml

# Python bytecode & packaging artifacts
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# Virtual environment (uv)
.venv/

# uv.lock IS committed — it pins exact dependency versions for reproducibility

# Runtime logs & per-game scratch (committed evidence lives under docs/ or tests/fixtures/)
logs/
# Watchdog state snapshots (PRD_gatekeeper §7 D4) — repo-wide, not just under logs/:
# M7-7(2), a drill that logged into docs/evidence/ left one in a TRACKED directory.
state_*.json
*.log
games/scratch/
artifacts/scratch/
arena/out/

# IDE & OS junk
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Ruff & mypy caches
.ruff_cache/
.mypy_cache/

# Temporary / scratch
tmp/
scratch/
*.tmp

# Claude Code worktrees & per-machine state — NEVER commit (paths/usernames leak)
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/settings.json
.claude/settings.local.json

# Cross-model PR-review scratch artifacts (never commit)
*.diff
patch.txt
review_payload.json
summary_review.md

# Sparring-host config, DERIVED not authored (M7-1): regenerate with
# `uv run python scripts/make_sparring_config.py`. Never committed - a second copy of
# the constitution is a drift hazard, and the recipe is what carries the guarantee.
config-sparring/
